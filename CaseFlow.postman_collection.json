            },
            "url": {
              "raw": "{{baseUrl}}/api/cases/{{caseId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases", "{{caseId}}", "assign"]
            }
          }
        },
        {
          "name": "Update Case Status (State Machine Enforced)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newStatus\": \"In Progress\",\n  \"note\": \"Field verification initiated by agent\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cases/{{caseId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases", "{{caseId}}", "status"]
            }
          }
        },
        {
